{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp-profiles.dev/spec/profile.schema.json",
  "title": "Profile",
  "description": "An MCP Profile: a reusable operating system for an agent, defining persona, memory, retrieval, tool permissions, and workflow.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "tools"],
  "properties": {
    "apiVersion": {
      "const": "mcp-profiles/v1",
      "description": "Spec version. Enables forward-compatible migration."
    },
    "kind": {
      "const": "Profile"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "Stable slug. Used as the switch key and as a namespace prefix."
        },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "version": { "type": "string" },
        "author": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "persona": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": { "type": "string" },
        "objectives": {
          "type": "array",
          "items": { "type": "string" }
        },
        "voice": { "type": "string" }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/memorySource" }
        },
        "retentionHint": {
          "type": "string",
          "enum": ["session-only", "persist-across-sessions"]
        }
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "type": "string",
          "enum": ["semantic", "keyword", "hybrid", "recency"]
        },
        "topK": {
          "type": "integer",
          "minimum": 1
        },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/retrievalSource" }
        },
        "fallback": {
          "type": "string",
          "description": "Free-form hint for what to do when no source matches (e.g. 'web-search')."
        }
      }
    },
    "tools": {
      "type": "object",
      "description": "The enforcement surface. The gateway re-exposes only the tools permitted here.",
      "additionalProperties": false,
      "required": ["defaultPolicy"],
      "properties": {
        "defaultPolicy": {
          "type": "string",
          "enum": ["deny", "allow"],
          "default": "deny"
        },
        "allow": {
          "type": "array",
          "items": { "$ref": "#/$defs/toolRule" }
        },
        "deny": {
          "type": "array",
          "items": { "$ref": "#/$defs/toolRule" }
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rules": {
          "type": "array",
          "items": { "type": "string" }
        },
        "procedures": {
          "type": "array",
          "items": { "$ref": "#/$defs/procedure" }
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "toolTimeoutMs": { "type": "integer", "minimum": 0 },
        "exposeProcedureAsPrompt": { "type": "boolean", "default": true },
        "exposeMemoryAsResource": { "type": "boolean", "default": true }
      }
    }
  },
  "$defs": {
    "memorySource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["inline", "mcp-resource", "file"]
        },
        "content": { "type": "string" },
        "uri": { "type": "string" },
        "path": { "type": "string" },
        "mode": {
          "type": "string",
          "enum": ["read", "read-write"],
          "default": "read"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "inline" } } },
          "then": { "required": ["content"] }
        },
        {
          "if": { "properties": { "type": { "const": "mcp-resource" } } },
          "then": { "required": ["uri"] }
        },
        {
          "if": { "properties": { "type": { "const": "file" } } },
          "then": { "required": ["path"] }
        }
      ]
    },
    "retrievalSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "via": {
          "type": "string",
          "description": "Id of a downstream server (see gateway config) backing this source."
        },
        "priority": { "type": "integer" }
      }
    },
    "toolRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["server", "tools"],
      "properties": {
        "server": {
          "type": "string",
          "description": "Downstream server id this rule applies to."
        },
        "tools": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(\\*|[a-zA-Z0-9_.-]+)$"
          },
          "description": "Tool names, or '*' for all tools of the server."
        },
        "rename": {
          "type": "object",
          "description": "Optional map of originalToolName -> exposed display name.",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.-]+$"
          }
        }
      }
    },
    "procedure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "steps"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    }
  }
}
