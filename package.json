{
  "name": "@youdotcom-oss/you-aware",
  "version": "0.1.0",
  "description": "Context-aware web search MCP for agent harnesses — reads your project's AGENTS.md, compiles project context into agent-shaped queries, and searches through the You.com Search API.",
  "license": "MIT",
  "author": "Brian Sparker <brian@you.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brainsparker/MCP-Profiles.git"
  },
  "homepage": "https://github.com/brainsparker/MCP-Profiles#readme",
  "bugs": {
    "url": "https://github.com/brainsparker/MCP-Profiles/issues"
  },
  "type": "module",
  "bin": {
    "you-aware": "dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "spec",
    "docs",
    "examples",
    "eval"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx src/eval/run.ts",
    "inspect": "npm run build && npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
