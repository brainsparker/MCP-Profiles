{
  "$comment": "Downstream MCP server registry. Profiles reference these by id. Keep secrets here, NOT in shareable profiles. ${VAR} placeholders are interpolated from the environment at startup.",
  "servers": {
    "amplitude-mcp": {
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "amplitude-mcp"],
      "env": { "AMPLITUDE_KEY": "${AMPLITUDE_KEY}" }
    },
    "notion-mcp": {
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@notionhq/notion-mcp-server"],
      "env": { "NOTION_TOKEN": "${NOTION_TOKEN}" }
    },
    "linear-mcp": {
      "transport": "http",
      "url": "https://mcp.linear.app/mcp",
      "headers": { "Authorization": "Bearer ${LINEAR_TOKEN}" }
    },
    "filesystem-mcp": {
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "."]
    }
  }
}
